[Unit]
Description=Telegram progress-reporting bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=progressbot
WorkingDirectory=/opt/telegram-progress-bot
EnvironmentFile=/etc/telegram-progress-bot.env
ExecStart=/opt/telegram-progress-bot/.venv/bin/python -m progress_bot --config /etc/telegram-progress-bot.toml
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
